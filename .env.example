# ---------------------------------------------------------------------------
# AI Product Intelligence Platform — environment configuration
# Copy to `.env` and fill in. Only ANTHROPIC_API_KEY is required for the
# AI analysis / chat features; everything else has working local defaults.
# ---------------------------------------------------------------------------

# --- Anthropic (required for /analyze and /chat) ---------------------------
# Get a key at https://console.anthropic.com/. Ingestion + knowledge-base build
# work without it; only the Claude-powered steps need it.
ANTHROPIC_API_KEY=
# Authoritative model id — do not append a date suffix.
ANTHROPIC_MODEL=claude-opus-4-8
# Max concurrent Claude calls during per-review analysis.
ANALYSIS_CONCURRENCY=5

# --- Application -----------------------------------------------------------
APP_NAME=AI Product Intelligence Platform
ENVIRONMENT=local
LOG_LEVEL=INFO
# Browser origins allowed to call the API (the Next.js dev server is :3000).
# Comma-separated; use "*" to allow any origin.
# PRODUCTION: https://app.YOUR_IP.nip.io (or your real domain, once you have one)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database --------------------------------------------------------------
# Local-first default is async SQLite. To switch to Postgres later, set e.g.
# postgresql+asyncpg://user:pass@localhost:5432/aipi  (no other code changes).
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- Vector store (Qdrant) -------------------------------------------------
# Local mode: a directory path, no server required. To use a Qdrant server,
# set QDRANT_URL=http://localhost:6333 and leave QDRANT_PATH blank.
QDRANT_PATH=./data/qdrant
QDRANT_URL=
QDRANT_COLLECTION=knowledge_base

# --- Embeddings ------------------------------------------------------------
# sentence-transformers model. Small + fast; downloads (~80MB) on first use.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Reddit (only needed for the reddit connector) --------------------------
# Public unauthenticated reddit.com/*.json access returns 403 as of Reddit's 2023+
# API changes, so this connector needs a free OAuth app. ~2 minutes to set up:
#   1. https://www.reddit.com/prefs/apps -> "create app" / "create another app"
#   2. Choose type "script", any name/redirect URI (e.g. http://localhost:8000)
#   3. Copy the id shown under the app name (client id) and the "secret" field
# pip install praw (or: pip install -e ".[collectors-extra]") before using this.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ai-product-intelligence-platform/0.1
