# Required — Claude reasoning (never committed; see main repo's ANTHROPIC_API_KEY for the same key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Required — real Spotify catalog grounding (Client Credentials flow, no user login)
# Create an app at https://developer.spotify.com/dashboard, Web API only.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Real user login (Authorization Code flow) — powers Dashboard/DNA/Chapters/
# Insights/Memories/Wrapped with genuine personal listening data once a user
# connects their Spotify account. Must exactly match a Redirect URI added
# under Dashboard → Settings → Redirect URIs. Unless the app has extended
# quota, each Spotify account that will sign in must also be added under
# Dashboard → User Management (up to 25 accounts).
# LOCAL DEV:  http://127.0.0.1:8010/auth/spotify/callback  (loopback is HTTPS-exempt)
# PRODUCTION: https://aura-api.YOUR_IP.nip.io/auth/spotify/callback (or your
#             real domain, once you have one) — Spotify requires HTTPS for any
#             non-loopback redirect URI. Hit by Spotify's own redirect
#             directly (never proxied through the frontend), so the aura
#             backend must be a real public HTTPS host.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8010/auth/spotify/callback

# Encrypts stored Spotify tokens at rest. Leave blank for local dev (a random
# one is generated per-process — every restart forces reconnecting Spotify).
# Generate a real one before deploying:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# CORS — the deployed frontend origin(s), comma-separated.
# PRODUCTION: https://aura.YOUR_IP.nip.io (or your real domain)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where the Spotify OAuth redirect sends the browser back to after connecting.
# PRODUCTION: https://aura.YOUR_IP.nip.io (or your real domain)
FRONTEND_BASE_URL=http://127.0.0.1:3010

# 0 disables rate limiting (only do this for local dev/tests). 120 leaves
# real headroom for normal navigation — several pages fire 5-8 parallel
# real-track lookups on mount alone.
RATE_LIMIT_PER_MINUTE=120

# Accounts (signup/signin) + per-user taste profile
DATABASE_URL=sqlite+aiosqlite:///./data/aura.db
# Signs session tokens. Leave blank for local dev (a random one is generated
# per-process — every restart signs everyone out). Set a real random value
# (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`) before
# deploying anywhere real.
JWT_SECRET=
